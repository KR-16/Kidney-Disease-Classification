# MLflow / DagsHub experiment tracking.
# Copy to `.env` and fill in, then export the vars into your shell before
# running the evaluation stage. `.env` is gitignored — never commit real creds.
#
# DagsHub: repo -> "Remote" -> "Experiments" gives you these values.
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/<repo>.mlflow
MLFLOW_TRACKING_USERNAME=<your-dagshub-username>
MLFLOW_TRACKING_PASSWORD=<your-dagshub-token>
